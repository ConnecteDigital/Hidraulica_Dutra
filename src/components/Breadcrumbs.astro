---
interface Props {
  items: { name: string; path: string }[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Você está em">
  <ol>
    {
      items.map((it, i) =>
        i < items.length - 1 ? (
          <li><a href={it.path}>{it.name}</a></li>
        ) : (
          <li aria-current="page">{it.name}</li>
        ),
      )
    }
  </ol>
</nav>
