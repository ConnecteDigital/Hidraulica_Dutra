---
// Abertura 3D da home. Só aparece quando o script do <head> marca a página
// com .intro-on (primeira visita da sessão, sem "reduzir movimento").
import { site } from '../data/site';
---

<div class="intro" id="intro" aria-hidden="true">
  <!-- capa: o primeiro quadro da cena, já renderizado, aparece na hora enquanto o 3D prepara -->
  <picture class="intro-poster">
    <source media="(max-aspect-ratio: 9/10)" srcset="/intro/poster-m.webp" />
    <img src="/intro/poster-d.webp" alt="" decoding="async" fetchpriority="high" onerror="this.remove()" />
  </picture>
  <canvas class="intro-canvas"></canvas>
  <div class="intro-caption">
    <p class="cap cap-leak">Vazamento?</p>
    <p class="cap cap-fix">A gente resolve.</p>
    <p class="cap cap-ok">Chegamos em até <strong>{site.arrivalMinutes} minutos</strong></p>
  </div>
  <button class="intro-skip" type="button">Pular</button>
</div>

<style is:global>
  .intro { display: none; }
  html.intro-on .intro {
    display: block; position: fixed; inset: 0; z-index: 200; background: #101113;
    transition: opacity .45s ease;
  }
  .intro.is-fading { opacity: 0; }
  /* durante a revelação o site já pode ser rolado e clicado na parte de cima */
  html.intro-on:has(.intro.is-revealing) body { overflow: auto; }
  .intro.is-revealing { pointer-events: none; }
  .intro.is-revealing .intro-caption { opacity: 0; transition: opacity .3s; }
  html.intro-on body { overflow: hidden; }
  .intro-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .intro-poster img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .intro::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(120% 90% at 50% 45%, transparent 50%, rgba(0, 0, 0, .65) 100%);
  }
  .intro-caption {
    position: absolute; left: 0; right: 0; top: 54%; text-align: center; pointer-events: none;
    font-family: var(--font-display); text-transform: uppercase; color: #fff; padding: 0 20px;
  }
  .intro-caption::before {
    content: ''; position: absolute; left: 50%; top: 0; width: 120%; height: 9em;
    transform: translate(-50%, -50%); font-size: clamp(1rem, 4vw, 1.6rem);
    background: radial-gradient(closest-side, rgba(5, 8, 14, .55), transparent);
    opacity: 0; transition: opacity .45s ease;
  }
  .intro[data-stage] .intro-caption::before { opacity: 1; }
  .cap {
    position: absolute; left: 0; right: 0; top: 0; margin: 0; padding: 0 20px; opacity: 0;
    transform: translateY(calc(-50% + 12px));
    transition: opacity .45s ease, transform .45s ease;
    font-size: clamp(2.6rem, 11vw, 4.6rem); font-weight: 800; line-height: 1.02; letter-spacing: .02em;
    text-shadow: 0 4px 24px rgba(0, 0, 0, .75), 0 1px 3px rgba(0, 0, 0, .6);
  }
  .cap strong { color: #5fd0ff; }
  .intro[data-stage='leak'] .cap-leak,
  .intro[data-stage='fix'] .cap-fix,
  .intro[data-stage='ok'] .cap-ok { opacity: 1; transform: translateY(-50%); }
  .intro-skip {
    position: absolute; top: max(16px, env(safe-area-inset-top)); right: 16px;
    background: rgba(255, 255, 255, .1); color: #fff; border: 1px solid rgba(255, 255, 255, .25);
    border-radius: 999px; padding: 8px 16px; font: 600 .9rem/1 var(--font-body); cursor: pointer;
  }
  .intro-skip:hover { background: rgba(255, 255, 255, .2); }
</style>
