---
// Animação provisória do hero: cano vazando -> chave aperta -> vazamento resolvido.
// Este componente é o ponto de troca para a futura cena 3D.
---

<div class="hero-visual" aria-hidden="true">
  <svg viewBox="0 0 480 360" class="scene">
    <defs>
      <linearGradient id="pipeGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f1f5fb" />
        <stop offset=".45" stop-color="#9fb0c8" />
        <stop offset="1" stop-color="#4b5d78" />
      </linearGradient>
      <linearGradient id="jointGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ffffff" />
        <stop offset=".5" stop-color="#b8c6da" />
        <stop offset="1" stop-color="#56688a" />
      </linearGradient>
      <linearGradient id="wrenchGrad" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#ff6a3d" />
        <stop offset="1" stop-color="#c8281a" />
      </linearGradient>
      <radialGradient id="glow" cx=".5" cy=".5" r=".5">
        <stop offset="0" stop-color="#2fa8ff" stop-opacity=".55" />
        <stop offset="1" stop-color="#2fa8ff" stop-opacity="0" />
      </radialGradient>
    </defs>

    <circle cx="240" cy="170" r="170" fill="url(#glow)" class="halo" />

    <!-- cano -->
    <rect x="0" y="140" width="480" height="44" rx="6" fill="url(#pipeGrad)" />
    <rect x="200" y="128" width="80" height="68" rx="8" fill="url(#jointGrad)" />
    <rect x="206" y="132" width="6" height="60" rx="3" fill="#ffffff" opacity=".7" />

    <!-- vazamento -->
    <g class="leak">
      <path class="spray" d="M262 140 C 290 90, 330 80, 360 96" />
      <path class="spray s2" d="M258 140 C 280 70, 310 50, 338 58" />
      <path class="spray s3" d="M266 142 C 300 110, 350 112, 380 130" />
      {Array.from({ length: 9 }).map((_, i) => (
        <circle class="droplet" cx={238 + (i % 3) * 12} cy="198" r={4 + (i % 2)} style={`animation-delay:${i * 0.18}s`} />
      ))}
      <ellipse class="puddle" cx="250" cy="330" rx="70" ry="10" />
    </g>

    <!-- chave de grifo -->
    <g class="wrench">
      <rect x="226" y="20" width="28" height="150" rx="10" fill="url(#wrenchGrad)" />
      <rect x="214" y="150" width="52" height="22" rx="4" fill="#cfd8e6" />
      <rect x="216" y="104" width="48" height="16" rx="3" fill="#8091ab" />
      <rect x="222" y="122" width="36" height="28" rx="3" fill="#e9eef6" />
    </g>

    <!-- resolvido -->
    <g class="fixed">
      <circle cx="240" cy="270" r="30" fill="#14b86a" />
      <path d="M226 270 l10 10 l20 -20" stroke="#fff" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  </svg>
  <div class="hero-visual-caption">
    <span class="step s-leak">Vazamento</span>
    <span class="step s-fix">Conserto</span>
    <span class="step s-ok">Resolvido</span>
  </div>
</div>

<style>
  .hero-visual {
    position: relative;
    border-radius: 28px;
    background: radial-gradient(120% 100% at 50% 0%, #12306e 0%, #071330 70%);
    border: 1px solid rgba(95, 208, 255, 0.25);
    box-shadow: 0 30px 80px -30px rgba(47, 168, 255, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    padding: 18px 18px 14px;
    overflow: hidden;
  }
  .scene { width: 100%; height: auto; display: block; }

  /* ciclo de 7s: vaza (0-45%), chave aperta (35-70%), resolvido (70-100%) */
  .leak { animation: leak 7s infinite; }
  .spray {
    fill: none; stroke: #5fd0ff; stroke-width: 6; stroke-linecap: round;
    stroke-dasharray: 10 14; animation: flow .5s linear infinite;
    filter: drop-shadow(0 0 6px rgba(95, 208, 255, .8));
  }
  .s2 { stroke-width: 4; animation-duration: .4s; }
  .s3 { stroke-width: 3; animation-duration: .6s; }
  .droplet { fill: #5fd0ff; animation: fall 1.1s ease-in infinite; }
  .puddle { fill: #2fa8ff; opacity: .35; }

  .wrench { transform-origin: 240px 160px; animation: wrench 7s infinite; }
  .fixed { opacity: 0; transform-origin: 240px 270px; animation: fixed 7s infinite; }
  .halo { animation: halo 7s infinite; }

  @keyframes flow { to { stroke-dashoffset: -24; } }
  @keyframes fall {
    0% { transform: translateY(0); opacity: 1; }
    100% { transform: translateY(125px); opacity: 0; }
  }
  @keyframes leak {
    0%, 45% { opacity: 1; }
    58%, 100% { opacity: 0; }
  }
  @keyframes wrench {
    0%, 25% { transform: translateY(-200px) rotate(-30deg); opacity: 0; }
    35% { transform: translateY(0) rotate(-25deg); opacity: 1; }
    45% { transform: translateY(0) rotate(10deg); }
    52% { transform: translateY(0) rotate(-15deg); }
    60% { transform: translateY(0) rotate(12deg); opacity: 1; }
    70% { transform: translateY(-200px) rotate(30deg); opacity: 0; }
    100% { transform: translateY(-200px) rotate(30deg); opacity: 0; }
  }
  @keyframes fixed {
    0%, 66% { opacity: 0; transform: scale(.4); }
    74% { opacity: 1; transform: scale(1.1); }
    80%, 94% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(1); }
  }
  @keyframes halo {
    0%, 45% { opacity: 1; }
    75%, 95% { opacity: .5; }
    100% { opacity: 1; }
  }

  .hero-visual-caption {
    display: flex; justify-content: center; gap: 8px; margin-top: 6px;
    font: 700 0.85rem/1 var(--font-display); letter-spacing: .06em; text-transform: uppercase;
  }
  .step { padding: 7px 12px; border-radius: 999px; color: #9fb7dd; background: rgba(255, 255, 255, .06); }
  .s-leak { animation: tag 7s infinite; }
  .s-fix { animation: tag 7s infinite; animation-delay: 2.45s; }
  .s-ok { animation: tag 7s infinite; animation-delay: 4.9s; }
  @keyframes tag {
    0%, 33% { background: #1662e8; color: #fff; }
    34%, 100% { background: rgba(255, 255, 255, .06); color: #9fb7dd; }
  }

  @media (prefers-reduced-motion: reduce) {
    .leak, .wrench, .halo, .step, .spray, .droplet { animation: none; }
    .leak, .wrench { opacity: 0; }
    .fixed { animation: none; opacity: 1; }
  }
</style>
