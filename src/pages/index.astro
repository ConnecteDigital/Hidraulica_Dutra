---
import Base from '../layouts/Base.astro';
import HeroVisual from '../components/HeroVisual.astro';
import CtaButtons from '../components/CtaButtons.astro';
import CtaBand from '../components/CtaBand.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import Gallery from '../components/Gallery.astro';
import { Image } from 'astro:assets';
import { fotoDoServico } from '../data/fotos';
import { site } from '../data/site';
import { servicos } from '../data/servicos';
import { bairrosPorZona, bairroPath, zonasPrioritarias } from '../data/bairros';
import { faqSchema } from '../data/schema';
import { getCollection } from 'astro:content';

const faq = [
  {
    q: 'O atendimento é 24 horas mesmo?',
    a: 'Sim. Atendemos 24 horas por dia, 7 dias por semana, incluindo fins de semana e feriados, em toda a cidade de São Paulo.',
  },
  {
    q: 'Em quanto tempo o encanador chega?',
    a: `Nossa equipe chega em até ${site.arrivalMinutes} minutos nas regiões atendidas.`,
  },
  {
    q: 'Os serviços têm garantia?',
    a: 'Sim. Todos os serviços da Hidráulica Dutra têm garantia.',
  },
  {
    q: 'Vocês vendem material hidráulico?',
    a: 'Não. Trabalhamos exclusivamente com mão de obra especializada em serviços hidráulicos, levando as peças necessárias para cada conserto.',
  },
  {
    q: 'Como chamo um encanador?',
    a: `É só chamar no WhatsApp ou ligar. Conte o que está acontecendo, de preferência com uma foto ou vídeo, e um encanador sai na hora para chegar em até ${site.arrivalMinutes} minutos.`,
  },
];

const fotoEquipe = fotoDoServico('desentupimento');

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime())
  .slice(0, 3);
---

<Base
  title="Encanador 24 Horas em São Paulo | Chegamos em 20 min | Hidráulica Dutra"
  description={site.description}
  schema={[faqSchema(faq)]}
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Encanador em São Paulo · Plantão 24h</span>
        <h1>Encanador 24 horas em São Paulo: <em>chegamos em até {site.arrivalMinutes} minutos</em></h1>
        <p class="hero-lead">
          Vazamento, cano furado, entupimento ou registro com defeito? A Hidráulica Dutra resolve hoje, a qualquer hora,
          com encanadores experientes e garantia no serviço.
        </p>
        <CtaButtons />
        <ul class="hero-badges">
          <li><Icon name="clock" size={18} /> Atendimento 24h</li>
          <li><Icon name="bolt" size={18} /> Chegada em até {site.arrivalMinutes} min</li>
          <li><Icon name="shield" size={18} /> Serviço com garantia</li>
        </ul>
      </div>
      <HeroVisual />
    </div>
  </section>

  <section class="trust" aria-label="Diferenciais">
    <div class="container trust-grid">
      <div class="trust-item"><Icon name="clock" size={34} /><div><strong>24 horas</strong><span>Todos os dias, inclusive feriados</span></div></div>
      <div class="trust-item"><Icon name="bolt" size={34} /><div><strong>{site.arrivalMinutes} minutos</strong><span>Tempo de chegada</span></div></div>
      <div class="trust-item"><Icon name="shield" size={34} /><div><strong>Garantia</strong><span>Em todos os serviços</span></div></div>
      <div class="trust-item"><Icon name="pin" size={34} /><div><strong>São Paulo</strong><span>Zona Norte, Oeste e mais</span></div></div>
    </div>
  </section>

  <section class="section section-soft" id="servicos">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Nossos serviços</span>
        <h2>Serviços de encanador em São Paulo</h2>
        <p>Do furo no cano ao desentupimento, cuidamos de toda a parte hidráulica da sua casa, apartamento ou empresa.</p>
      </div>
      <div class="services-grid">
        {servicos.map((s) => <ServiceCard servico={s} />)}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Como funciona</span>
        <h2>Do chamado ao problema resolvido</h2>
        <p>Sem enrolação: você chama, a gente chega e resolve.</p>
      </div>
      <div class="steps">
        <div class="step-card">
          <h3>Chame no WhatsApp ou ligue</h3>
          <p>Conte o que está acontecendo. Se puder, mande uma foto ou um vídeo do problema.</p>
        </div>
        <div class="step-card">
          <h3>Chegamos em até {site.arrivalMinutes} minutos</h3>
          <p>Assim que você chama, um encanador já sai para o endereço. Em até {site.arrivalMinutes} minutos ele está aí para conter o problema.</p>
        </div>
        <div class="step-card">
          <h3>Serviço feito com garantia</h3>
          <p>Consertamos, testamos tudo na sua frente e deixamos o local limpo.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-grid">
      {
        fotoEquipe && (
          <div class="about-photo">
            <Image src={fotoEquipe.src} alt={fotoEquipe.alt} widths={[400, 600, 800]} sizes="(max-width: 900px) 100vw, 460px" />
          </div>
        )
      }
      <div>
      <div class="section-head">
        <span class="eyebrow">Por que a Hidráulica Dutra</span>
        <h2>Encanador de confiança, a qualquer hora</h2>
        <p>Equipe própria, uniformizada e equipada para resolver desde um furo no cano até o desentupimento de uma coluna de esgoto.</p>
      </div>
      <div class="features">
        <div class="feature">
          <Icon name="clock" size={30} />
          <div><h3>Plantão 24 horas</h3><p>Vazamento não espera horário comercial. Atendemos de madrugada, fins de semana e feriados.</p></div>
        </div>
        <div class="feature">
          <Icon name="bolt" size={30} />
          <div><h3>Chegamos em {site.arrivalMinutes} minutos</h3><p>Emergência não pode esperar. Em até {site.arrivalMinutes} minutos um encanador está na sua porta para conter o vazamento e evitar estragos.</p></div>
        </div>
        <div class="feature">
          <Icon name="shield" size={30} />
          <div><h3>Garantia no serviço</h3><p>Todo conserto sai com garantia. Se algo der errado, voltamos para resolver.</p></div>
        </div>
        <div class="feature">
          <Icon name="check" size={30} />
          <div><h3>Resolvido na primeira visita</h3><p>Chegamos equipados com ferramentas e peças para resolver o problema já no primeiro atendimento.</p></div>
        </div>
      </div>
      </div>
    </div>
  </section>

  <CtaBand />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Trabalhos realizados</span>
        <h2>Serviços que já fizemos</h2>
        <p>Fotos reais de atendimentos da Hidráulica Dutra em São Paulo.</p>
      </div>
      <Gallery limit={8} exclude="desentupimento" />
    </div>
  </section>

  <section class="section section-soft" id="areas">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Áreas atendidas</span>
        <h2>Encanador perto de você</h2>
        <p>Atendemos toda a cidade de São Paulo, com foco na Zona Norte e na Zona Oeste.</p>
      </div>
      <div class="zones">
        {
          bairrosPorZona().map((g) => (
            <div class:list={['zone', { 'is-priority': zonasPrioritarias.includes(g.zona) }]}>
              <h3>
                {g.zona}
                {zonasPrioritarias.includes(g.zona) && <span class="tag">Foco</span>}
              </h3>
              <ul>
                {g.bairros.map((b) => (
                  <li>
                    <a href={bairroPath(b)}>
                      <Icon name="pin" size={16} /> Encanador em {b.nome}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Blog</span>
            <h2>Dicas de hidráulica</h2>
          </div>
          <div class="posts">
            {posts.map((p) => (
              <a class="post-card" href={`/blog/${p.id}/`}>
                <time datetime={p.data.data.toISOString()}>{p.data.data.toLocaleDateString('pt-BR')}</time>
                <h3>{p.data.titulo}</h3>
                <p>{p.data.descricao}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section-soft">
    <div class="container" style="max-width: 860px">
      <div class="section-head">
        <span class="eyebrow">Dúvidas frequentes</span>
        <h2>Perguntas frequentes</h2>
      </div>
      <FaqList items={faq} />
    </div>
  </section>

  <CtaBand title="Precisa de um encanador agora?" />
</Base>
